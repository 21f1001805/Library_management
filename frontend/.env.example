# Leave unset — the backend lives in this same Next.js app (app/api/v1/...), so api.ts
# calls it with a relative path. Only set this to point at a different origin serving
# the same /api/v1 routes (e.g. a separately-deployed instance).
# NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-side only, read by src/server/*.
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
# Chat assistant conversation memory (Redis-backed, see src/server/chat/history.ts)
CHAT_HISTORY_TTL_SECONDS=3600
CHAT_HISTORY_MAX_TURNS=5
# Read only by `bun run start:jobs` (src/jobs/index.ts), not this Next.js server itself.
# AUTO_MIGRATE=false if your deployment applies migrations as its own step.
# AUTO_SEED_DEMO=false to skip the dev-only demo-seed scripts on job-runner startup.
AUTO_MIGRATE=true
AUTO_SEED_DEMO=true
JWT_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:3000

# ── AI features (books insights/cover-identify/suggest-description, recommendations'
# describe-to-quiz, review/guardian digests) ─────────────────────────────────────────
# Set LLM_MODE to one of: openai | bedrock | ollama
LLM_MODE=ollama
LLM_DEBUG=false

# OpenAI (used when LLM_MODE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS Bedrock (used when LLM_MODE=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Ollama (used when LLM_MODE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Separate model, only used for "You may also like" book similarity — not the chat model.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Left blank in dev — auth/mail.ts logs to console instead of sending when unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
